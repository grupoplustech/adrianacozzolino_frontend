---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contacto Oficial | Adriana Cozzolino - Tarjeta Digital"
  description="Tarjeta de presentación digital oficial de Adriana Cozzolino, Superintendente de Arte y Cultura de Baruta. Guarda los datos de contacto directamente en tu teléfono móvil."
>
  <main class="min-h-screen bg-gradient-to-b from-[#080b11] via-[#0d121c] to-[#04060a] flex items-center justify-center p-4 sm:p-6 py-12">
    
    <div class="w-full max-w-md bg-[#0f1422] border border-gold-500/40 rounded-3xl shadow-2xl overflow-hidden relative">
      
      <!-- Top banner accent -->
      <div class="h-28 bg-gradient-to-r from-gold-600 via-gold-400 to-gold-700 relative">
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="absolute top-4 left-6 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-[11px] font-bold tracking-widest text-black uppercase">Contacto Verificado</span>
        </div>
      </div>

      <!-- Avatar overlap -->
      <div class="px-6 -mt-16 text-center">
        <div class="inline-block relative">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-[#0f1422] shadow-xl bg-slate-800 mx-auto">
            <img 
              src="/images/adriana-cozzolino-hero.webp" 
              alt="Adriana Cozzolino" 
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute bottom-1 right-2 bg-gold-400 text-black p-1.5 rounded-full shadow-md" title="Superintendente">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
          </div>
        </div>

        <!-- Name and Titles -->
        <h1 class="font-serif text-2xl font-bold text-white mt-4">
          Adriana Cozzolino
        </h1>
        <p class="text-xs font-semibold uppercase tracking-wider text-gold-400 mt-1">
          Superintendente de Arte y Cultura
        </p>
        <p class="text-[11px] text-slate-400 mt-0.5">
          Alcaldía de Baruta • Baruta Cultural
        </p>
        <p class="text-xs text-slate-300 mt-3 font-medium px-2 leading-relaxed">
          Productora ejecutiva y estratega de proyectos culturales de gran escala. Impulsora de CaminArte.
        </p>
      </div>

      <!-- Main Action: Save to Phone -->
      <div class="p-6 space-y-3">
        
        <a 
          href="/adriana-cozzolino.vcf" 
          download="Adriana_Cozzolino.vcf"
          class="w-full flex items-center justify-center gap-3 py-3.5 px-4 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 hover:from-gold-500 hover:to-gold-700 text-black font-bold text-sm tracking-wide shadow-lg shadow-gold-500/20 transition-all hover:scale-[1.02]"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
            <path d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z"/>
          </svg>
          Guardar en Contactos (.vcf)
        </a>

        <!-- Social & Web Buttons -->
        <div class="grid grid-cols-2 gap-3 pt-2">
          <a 
            href="https://www.instagram.com/adriario/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg border border-slate-700 hover:border-gold-500/50 bg-slate-900/60 text-slate-200 text-xs font-semibold transition-all hover:text-gold-400"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            @adriario
          </a>

          <a 
            href="https://www.instagram.com/barutacultural/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg border border-slate-700 hover:border-gold-500/50 bg-slate-900/60 text-slate-200 text-xs font-semibold transition-all hover:text-gold-400"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            @barutacultural
          </a>
        </div>

        <a 
          href="/" 
          class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl border border-slate-700 hover:border-gold-400 bg-slate-900/80 text-white text-xs font-semibold transition-all"
        >
          Explorar Sitio Web Completo →
        </a>

        <!-- Download high-res card -->
        <a 
          href="/images/tarjeta-presentacion-qr.png" 
          download="Tarjeta_Presentacion_Adriana_Cozzolino.png"
          class="block text-center text-[11px] text-slate-400 hover:text-gold-400 pt-2 transition-colors underline"
        >
          Descargar Tarjeta en Alta Resolución (PNG)
        </a>

      </div>

      <!-- QR Box display -->
      <div class="px-6 pb-6 pt-2 text-center border-t border-slate-800/80">
        <p class="text-[10px] uppercase tracking-wider text-slate-400 mb-2 font-medium">Comparte esta tarjeta</p>
        <div class="w-32 h-32 mx-auto p-2 bg-white rounded-xl shadow-md inline-block">
          <img src="/images/qr-adrianacozzolino.png" alt="QR Contacto Adriana Cozzolino" class="w-full h-full" />
        </div>
      </div>

    </div>

  </main>
</Layout>
