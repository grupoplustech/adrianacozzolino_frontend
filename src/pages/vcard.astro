---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contacto Oficial | Adriana Cozzolino - Tarjeta Digital"
  description="Tarjeta de presentación digital oficial de Adriana Cozzolino, Superintendente de Arte y Cultura de Baruta y Directora en Alfa-Branding. Guarda los datos de contacto directamente en tu teléfono móvil."
>
  <main class="min-h-screen bg-gradient-to-b from-[#080b11] via-[#0d121c] to-[#04060a] flex items-center justify-center p-4 sm:p-6 py-10 sm:py-14">
    
    <div class="w-full max-w-md bg-[#0f1422] border border-gold-500/40 rounded-3xl shadow-2xl overflow-hidden relative">
      
      <!-- Top banner accent -->
      <div class="h-28 bg-gradient-to-r from-gold-600 via-gold-400 to-gold-700 relative">
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="absolute top-4 left-6 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-[11px] font-bold tracking-widest text-black uppercase">Contacto Verificado</span>
        </div>
      </div>

      <!-- Avatar overlap -->
      <div class="px-6 -mt-16 text-center">
        <div class="inline-block relative">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-[#0f1422] shadow-xl bg-slate-800 mx-auto">
            <img 
              src="/images/adriana-cozzolino-caminarte-hero.webp" 
              alt="Adriana Cozzolino" 
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute bottom-1 right-2 bg-gold-400 text-black p-1.5 rounded-full shadow-md" title="Superintendente">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
          </div>
        </div>

        <!-- Name and Titles -->
        <h1 class="font-serif text-2xl font-bold text-white mt-4">
          Adriana Cozzolino
        </h1>
        <p class="text-xs font-semibold uppercase tracking-wider text-gold-400 mt-1">
          Superintendente de Arte y Cultura
        </p>
        <p class="text-[11px] text-slate-400 mt-0.5">
          Alcaldía de Baruta • Baruta Cultural • Directora en Alfa-Branding
        </p>
        <p class="text-xs text-slate-300 mt-2.5 font-medium px-2 leading-relaxed">
          Productora ejecutiva, estratega de marcas y eventos de gran escala. Creadora de CaminArte.
        </p>
      </div>

      <!-- Quick Contact Direct Actions -->
      <div class="px-6 pt-5 pb-3">
        <div class="grid grid-cols-2 gap-2.5">
          <!-- WhatsApp Call/Chat -->
          <a 
            href="https://wa.me/584242511908" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center justify-center gap-2 py-3 px-3 rounded-xl bg-emerald-500/15 border border-emerald-500/40 hover:bg-emerald-500/25 text-emerald-300 font-semibold text-xs transition-all active:scale-95"
          >
            <svg class="w-4 h-4 fill-current text-emerald-400 flex-shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>WhatsApp</span>
          </a>

          <!-- Direct Phone Call -->
          <a 
            href="tel:+584242511908" 
            class="flex items-center justify-center gap-2 py-3 px-3 rounded-xl bg-slate-800/80 border border-slate-700/80 hover:border-gold-500/50 hover:bg-slate-800 text-slate-200 font-semibold text-xs transition-all active:scale-95"
          >
            <svg class="w-4 h-4 fill-current text-gold-400 flex-shrink-0" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
            </svg>
            <span>Llamar</span>
          </a>
        </div>

        <!-- Email Button -->
        <a 
          href="mailto:Adriccc812@gmail.com" 
          class="mt-2.5 w-full flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-slate-900/90 border border-slate-700/80 hover:border-gold-400 text-slate-200 hover:text-gold-300 font-semibold text-xs transition-all active:scale-95"
        >
          <svg class="w-4 h-4 fill-current text-gold-400 flex-shrink-0" viewBox="0 0 20 20">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
          </svg>
          <span class="truncate">Adriccc812@gmail.com</span>
        </a>
      </div>

      <!-- Main Actions: Save to Phone (.vcf) & Download Image (.png) -->
      <div class="px-6 pb-6 pt-2 space-y-2.5">
        
        <a 
          href="/adriana-cozzolino.vcf" 
          download="Adriana_Cozzolino.vcf"
          class="w-full flex items-center justify-center gap-3 py-3.5 px-4 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 hover:from-gold-500 hover:to-gold-700 text-black font-bold text-sm tracking-wide shadow-lg shadow-gold-500/20 transition-all hover:scale-[1.02] active:scale-95"
        >
          <svg class="w-5 h-5 fill-current flex-shrink-0" viewBox="0 0 20 20">
            <path d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z"/>
          </svg>
          <span>Guardar en Contactos (.vcf)</span>
        </a>

        <a 
          href="/images/tarjeta-presentacion-qr.png" 
          download="Tarjeta_Adriana_Cozzolino.png"
          class="w-full flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl border border-gold-500/50 hover:border-gold-400 bg-gold-500/10 hover:bg-gold-500/20 text-gold-300 font-semibold text-xs tracking-wide transition-all active:scale-95"
        >
          <svg class="w-4 h-4 fill-current flex-shrink-0" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
          <span>Descargar Tarjeta en Imagen (PNG)</span>
        </a>

        <!-- Social Buttons -->
        <div class="grid grid-cols-2 gap-2.5 pt-1">
          <a 
            href="https://www.instagram.com/adriario/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg border border-slate-700 hover:border-gold-500/50 bg-slate-900/60 text-slate-200 text-xs font-semibold transition-all hover:text-gold-400"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@adriario</span>
          </a>

          <a 
            href="https://www.instagram.com/barutacultural/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg border border-slate-700 hover:border-gold-500/50 bg-slate-900/60 text-slate-200 text-xs font-semibold transition-all hover:text-gold-400"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@barutacultural</span>
          </a>
        </div>

        <!-- Link to full website -->
        <a 
          href="/" 
          class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl border border-slate-700 hover:border-gold-400 bg-slate-900/80 text-white text-xs font-semibold transition-all"
        >
          <span>Visitar adrianacozzolino.com</span>
          <span>→</span>
        </a>

      </div>

      <!-- QR Box display -->
      <div class="px-6 pb-6 pt-3 text-center border-t border-slate-800/80">
        <p class="text-[10px] uppercase tracking-wider text-slate-400 mb-2 font-medium">Comparte esta tarjeta con tu smartphone</p>
        <div class="w-32 h-32 mx-auto p-2 bg-white rounded-xl shadow-md inline-block">
          <img src="/images/qr-adrianacozzolino.png" alt="QR Contacto Adriana Cozzolino" class="w-full h-full" />
        </div>
        <p class="text-[10px] text-slate-400 mt-2.5">
          Escanea para guardar o <a href="/images/tarjeta-presentacion-qr.png" download="Tarjeta_Adriana_Cozzolino.png" class="text-gold-400 hover:underline font-semibold">descarga la tarjeta en imagen PNG</a>
        </p>
      </div>

    </div>

  </main>
</Layout>
